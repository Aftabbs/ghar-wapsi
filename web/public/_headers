# Cloudflare Pages response headers (GitHub Pages serves this file but ignores it).
# Built JS and CSS have content hashes in their names, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data and images keep their names across releases: an hour, then check for a new copy.
/data/*
  Cache-Control: public, max-age=3600, must-revalidate
/og.png
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
